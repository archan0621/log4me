<section class="home-section">
  <div class="section-title-row">
    <h2>최근 글</h2>
    <a href="/blog/">전체 보기</a>
  </div>

  {% if collections.postsByDate.length %}
    <ul class="post-list compact-post-list">
      {% for post in collections.postsByDate %}
        {% if loop.index0 < 3 %}
          <li>
            <a class="post-link" href="{{ post.url }}">
              <time datetime="{{ post.date | htmlDateString }}">{{ post.date | htmlDateString }}</time>
              <span>{{ post.data.title }}</span>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  {% else %}
    <p class="muted">아직 쓴 글이 없습니다.</p>
  {% endif %}
</section>
