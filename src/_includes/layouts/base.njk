<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} - {% endif %}Archan's Log4Me</title>
    <meta name="description" content="{{ description or '기록하고, 만들고, 오래 생각하는 개인 공간입니다.' }}">
    <meta name="theme-color" content="#050505">
    <meta name="color-scheme" content="dark">
    <meta property="og:title" content="{% if title %}{{ title }} - {% endif %}Archan's Log4Me">
    <meta property="og:description" content="{{ description or '기록하고, 만들고, 오래 생각하는 개인 공간입니다.' }}">
    <meta property="og:type" content="website">
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <header class="site-header">
      <div class="wrapper">
        <a class="site-title" href="/">
          Archan's Log4Me
        </a>
        <nav class="site-nav" aria-label="주요 메뉴">
          <a href="/">홈</a>
          <a href="/blog/">글</a>
        </nav>
      </div>
    </header>

    <main class="page-content">
      <div class="wrapper">
        {% if isPost %}
          <article class="post">
            <header class="post-header">
              <p class="eyebrow">note / {{ date | htmlDateString }}</p>
              <h1 class="post-title">{{ title }}</h1>
            </header>

            <div class="post-content">
              {{ content | safe }}
            </div>

            <p class="back-link"><a href="/blog/">글 목록으로 돌아가기</a></p>
          </article>
        {% else %}
          {{ content | safe }}
        {% endif %}
      </div>
    </main>

    <footer class="site-footer"></footer>
  </body>
</html>
